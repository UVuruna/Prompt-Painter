# EVERYTHING the program generates — images, run state, reports and
# the AI-generated prompt sheets — under ONE root (owner 2026-08-04,
# config.GENERATED_ROOT). One folder to ignore, back up, or empty.
output/

# the pre-2026-08-04 locations, kept ignored so an existing run's
# folder never shows up as untracked (nothing is moved automatically)
out/
sheets/

# The owner's private material shown to agents (never committed)
UV/

# The dedicated Chrome automation profile (logged-in sessions)
chrome-profile/

# Downloaded external binaries (Real-ESRGAN) — never committed
tools/

# Tool before/after backups (restore engine) — transient, never committed
.painter_tmp/

# The owner's local GUI settings (root-anchored — must NOT also match
# .claude/settings.json, which is tracked project hook configuration)
/settings.json

# Build outputs (PyInstaller + NSIS pipeline — setup/build.py)
build/
dist/
*.spec
setup/version_info.txt

# Generated app icon (rebuilt from assets/logo.svg on every build)
assets/icon.ico

# Code signing certificate (never commit — back up externally)
setup/cert/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Claude Code working folder - never tracked (owner decree 2026-08-09).
# Covers .claude/sessions/ and .claude/evidence/ (rules/history/
# 2026-08-18-rework-design.md) too — nothing under .claude/ is product
# code. ONE exception: uv_windows.py is the `uv shot` window registry a
# fresh clone needs (rules/howto/runner.md) — un-ignored below. (`.claude/*`,
# not `.claude/` — git cannot un-ignore a file inside an already-ignored
# DIRECTORY, only inside an ignored directory's CONTENTS.)
.claude/*
!.claude/uv_windows.py
